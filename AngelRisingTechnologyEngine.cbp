<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="AngelRisingTechnologyEngine" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Release">
				<Option output="bin/Release/AngelRisingTechnologyEngine" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-std=gnu++20" />
			<Add directory="ThirdParty/include/AngelScript" />
			<Add directory="ThirdParty/include/GLAD" />
			<Add directory="ThirdParty/include/GLFW" />
			<Add directory="ThirdParty/include/GLM" />
			<Add directory="ThirdParty/include/JsonNlohmann" />
			<Add directory="ThirdParty/include/TinyglTF" />
			<Add directory="ThirdParty/include/AL" />
			<Add directory="ThirdParty/include/ReactPhysics3D" />
			<Add directory="ThirdParty/include/EnTT" />
		</Compiler>
		<Linker>
			<Add library="ThirdParty/libs/win_x64/libangelscript64.a" />
			<Add library="ThirdParty/libs/win_x64/libglfw3.a" />
			<Add library="ThirdParty/libs/win_x64/libglfw3dll.a" />
			<Add library="ThirdParty/libs/win_x64/libOpenAL32.dll.a" />
			<Add library="ThirdParty/libs/win_x64/libreactphysics3d.a" />
			<Add directory="ThirdParty/libs/win_x64" />
		</Linker>
		<Unit filename="ThirdParty/include/GLAD/glad.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/artenttmodules.h" />
		<Unit filename="src/engineentity.cpp" />
		<Unit filename="src/engineshader.cpp" />
		<Unit filename="src/engineshader.h" />
		<Unit filename="src/enginestring.h" />
		<Unit filename="src/enginewindow.cpp" />
		<Unit filename="src/enginewindow.h" />
		<Unit filename="src/main.cpp" />
		<Extensions>
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
